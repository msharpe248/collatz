def c (m : ℕ) : ℕ := (certChunk ((m - 2) / 3 / 243)).getD ((m - 2) / 3 % 243) 1

/-- Witness root for class m: the small integer a = m + 6561·q (q ∈ {0,1})
    whose Terras orbit reaches 8. Tiny by design: kernel evaluation of
    `terras_iter (wS m) (wA m) = 8` is a shallow walk on small numbers,
    unlike the 2^j primitive-root witnesses it replaces. -/
def wA (m : ℕ) : ℕ :=
  m + 6561 * (qChunk ((m - 2) / 3 / 243)).getD ((m - 2) / 3 % 243) 0

/-- Steps from the witness root to 8 (at most 146). -/
def wS (m : ℕ) : ℕ := (sChunk ((m - 2) / 3 / 243)).getD ((m - 2) / 3 % 243) 0

def cbar (w : ℕ) : ℕ := min (c w) (min (c (w + 2187)) (c (w + 4374)))

