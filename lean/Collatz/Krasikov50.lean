theorem cert_bounds : ∀ m, m < 6561 → m % 3 = 2 →
    1 ≤ c m ∧ c m ≤ 621756 := fun m hm => cert_bounds_all m hm

theorem cert_ok : ∀ m, m < 6561 → m % 3 = 2 →
    (m % 9 = 5 → c m * 1261 ^ 100 ≤ c (4 * m % 6561) * 1250 ^ 100) ∧
    (m % 9 = 2 → c m * 1261 ^ 100 ≤ c (4 * m % 6561) * 1250 ^ 100 +
      cbar ((4 * m - 2) % 6561 / 3) * (1261 ^ 79 * 1250 ^ 21)) ∧
    (m % 9 = 8 → c m * 1261 ^ 100 ≤ c (4 * m % 6561) * 1250 ^ 100 +
      cbar ((2 * m - 1) % 6561 / 3) * (1261 ^ 99 * 1250)) :=
  fun m hm => cert_ok_all m hm

theorem wit_ok : ∀ m, m < 6561 → m % 3 = 2 →
    3 ≤ wA m ∧ wA m % 6561 = m ∧ terras_iter (wS m) (wA m) = 8 :=
  fun m hm => wit_ok_all m hm

theorem roots_nonempty : ∀ m, m < 6561 → m % 3 = 2 →
    (Roots 8 m).Nonempty := by
  intro m hm h3
  obtain ⟨hw3, hwm, hws⟩ := wit_ok m hm h3
  refine ⟨wA m, hw3, ?_, wS m, hws⟩
  rw [show (3 : ℕ) ^ 8 = 6561 by norm_num]
  exact hwm

/-- Base-case power swap: (1261/1250)^t ≤ (1261/1250)^100 for t ≤ 100,
    in pure ℕ form. -/
theorem pow_swap {t : ℕ} (ht : t ≤ 100) :
    (1261 : ℕ) ^ t * 1250 ^ 100 ≤ 1250 ^ t * 1261 ^ 100 := by
  have e1 : (1261 : ℕ) ^ 100 = 1261 ^ t * 1261 ^ (100 - t) := by
    rw [← pow_add]
    congr 1
    omega
  have e2 : (1250 : ℕ) ^ 100 = 1250 ^ t * 1250 ^ (100 - t) := by
    rw [← pow_add]
    congr 1
    omega
  rw [e1, e2]
  have h := Nat.pow_le_pow_left (show (1250 : ℕ) ≤ 1261 by norm_num) (100 - t)
  calc (1261 : ℕ) ^ t * (1250 ^ t * 1250 ^ (100 - t))
      = (1261 ^ t * 1250 ^ t) * 1250 ^ (100 - t) := by ring
    _ ≤ (1261 ^ t * 1250 ^ t) * 1261 ^ (100 - t) :=
        Nat.mul_le_mul_left _ h
    _ = 1250 ^ t * (1261 ^ t * 1261 ^ (100 - t)) := by ring

/-- THE GROWTH THEOREM on the 1/50 grid: phi50 grows like
    (1261/1250)^t per grid step — fifty steps per doubling, so the
    exponent is 50·log₂(1261/1250) = 0.63201… . -/
theorem growth : ∀ t m, m < 6561 → m % 3 = 2 →
    c m * 1261 ^ t * 1250 ^ 100 ≤
      phi50 8 m t * (621756 * 1250 ^ t * 1261 ^ 100) := by
  intro t
  induction t using Nat.strong_induction_on with
  | _ t ih =>
    intro m hm hm3
    have hb := cert_bounds m hm hm3
    have hne := roots_nonempty m hm hm3
    have hphi1 := phi50_ge_one (t := t) hne
    rcases lt_or_ge t 100 with ht | ht
    · -- base: t < 100
      calc c m * 1261 ^ t * 1250 ^ 100
          = c m * (1261 ^ t * 1250 ^ 100) := by ring
        _ ≤ 621756 * (1261 ^ t * 1250 ^ 100) :=
            Nat.mul_le_mul_right _ hb.2
        _ ≤ 621756 * (1250 ^ t * 1261 ^ 100) :=
            Nat.mul_le_mul_left _ (pow_swap (by omega))
        _ = 1 * (621756 * 1250 ^ t * 1261 ^ 100) := by ring
        _ ≤ phi50 8 m t * (621756 * 1250 ^ t * 1261 ^ 100) :=
            Nat.mul_le_mul_right _ hphi1
    · -- step: t ≥ 100
      obtain ⟨t', rfl⟩ : ∃ t', t = t' + 100 := ⟨t - 100, by omega⟩
      have e8 : (3 : ℕ) ^ 8 = 6561 := by norm_num
      have hm4 : 4 * m % 6561 < 6561 := Nat.mod_lt _ (by norm_num)
      have hm43 : (4 * m % 6561) % 3 = 2 := by omega
      have ih4 := ih t' (by omega) (4 * m % 6561) hm4 hm43
      have h9 : m % 9 = 2 ∨ m % 9 = 5 ∨ m % 9 = 8 := by omega
      have hcert := cert_ok m hm hm3
      rcases h9 with h9 | h9 | h9
      · -- m ≡ 2 (mod 9): branch with 21-step retardation
        have hrec := phi50_rec_two (k := 8) (m := m) (t := t')
          (by norm_num) h9 hne
        rw [e8] at hrec
        have hw : (4 * m - 2) % 6561 / 3 < 2187 := by
          have : (4 * m - 2) % 6561 < 6561 := Nat.mod_lt _ (by norm_num)
          omega
        have hw3 : ((4 * m - 2) % 6561 / 3) % 3 = 2 := by omega
        set w := (4 * m - 2) % 6561 / 3 with hwdef
        have ihw1 := ih (t' + 79) (by omega) w (by omega) hw3
        have ihw2 := ih (t' + 79) (by omega) (w + 2187) (by omega) (by omega)
        have ihw3 := ih (t' + 79) (by omega) (w + 4374) (by omega) (by omega)
        have hmin : cbar w * 1261 ^ (t' + 79) * 1250 ^ 100 ≤
            phiMin50 8 w (t' + 79) *
              (621756 * 1250 ^ (t' + 79) * 1261 ^ 100) := by
          unfold cbar phiMin50
          rw [show (3 : ℕ) ^ (8 - 1) = 2187 by norm_num,
            show (2 * 2187 : ℕ) = 4374 by norm_num]
          have key := K5.min3_mul_bound
            (E := 1261 ^ (t' + 79) * 1250 ^ 100)
            (D := 621756 * 1250 ^ (t' + 79) * 1261 ^ 100)
            (by calc c w * (1261 ^ (t' + 79) * 1250 ^ 100)
                  = c w * 1261 ^ (t' + 79) * 1250 ^ 100 := by ring
                _ ≤ _ := ihw1)
            (by calc c (w + 2187) * (1261 ^ (t' + 79) * 1250 ^ 100)
                  = c (w + 2187) * 1261 ^ (t' + 79) * 1250 ^ 100 := by ring
                _ ≤ _ := ihw2)
            (by calc c (w + 4374) * (1261 ^ (t' + 79) * 1250 ^ 100)
                  = c (w + 4374) * 1261 ^ (t' + 79) * 1250 ^ 100 := by ring
                _ ≤ _ := ihw3)
          calc min (c w) (min (c (w + 2187)) (c (w + 4374))) *
                1261 ^ (t' + 79) * 1250 ^ 100
              = min (c w) (min (c (w + 2187)) (c (w + 4374))) *
                (1261 ^ (t' + 79) * 1250 ^ 100) := by ring
            _ ≤ _ := key
        have hcm := (hcert.2.1) h9
        calc c m * 1261 ^ (t' + 100) * 1250 ^ 100
            = (c m * 1261 ^ 100) * (1261 ^ t' * 1250 ^ 100) := by ring
          _ ≤ (c (4 * m % 6561) * 1250 ^ 100 +
                cbar w * (1261 ^ 79 * 1250 ^ 21)) *
              (1261 ^ t' * 1250 ^ 100) := Nat.mul_le_mul_right _ hcm
          _ = (c (4 * m % 6561) * 1261 ^ t' * 1250 ^ 100) * 1250 ^ 100 +
              (cbar w * 1261 ^ (t' + 79) * 1250 ^ 100) * 1250 ^ 21 := by
              ring
          _ ≤ (phi50 8 (4 * m % 6561) t' *
                (621756 * 1250 ^ t' * 1261 ^ 100)) * 1250 ^ 100 +
              (phiMin50 8 w (t' + 79) *
                (621756 * 1250 ^ (t' + 79) * 1261 ^ 100)) * 1250 ^ 21 :=
              Nat.add_le_add (Nat.mul_le_mul_right _ ih4)
                (Nat.mul_le_mul_right _ hmin)
          _ = (phi50 8 (4 * m % 6561) t' + phiMin50 8 w (t' + 79)) *
              (621756 * 1250 ^ (t' + 100) * 1261 ^ 100) := by ring
          _ ≤ phi50 8 m (t' + 100) *
              (621756 * 1250 ^ (t' + 100) * 1261 ^ 100) :=
              Nat.mul_le_mul_right _ hrec
      · -- m ≡ 5 (mod 9): pure doubling branch
        have hrec := phi50_rec_five (k := 8) (m := m) (t := t') hne
        rw [e8] at hrec
        have hcm := (hcert.1) h9
        calc c m * 1261 ^ (t' + 100) * 1250 ^ 100
            = (c m * 1261 ^ 100) * (1261 ^ t' * 1250 ^ 100) := by ring
          _ ≤ (c (4 * m % 6561) * 1250 ^ 100) *
              (1261 ^ t' * 1250 ^ 100) := Nat.mul_le_mul_right _ hcm
          _ = (c (4 * m % 6561) * 1261 ^ t' * 1250 ^ 100) * 1250 ^ 100 := by
              ring
          _ ≤ (phi50 8 (4 * m % 6561) t' *
                (621756 * 1250 ^ t' * 1261 ^ 100)) * 1250 ^ 100 :=
              Nat.mul_le_mul_right _ ih4
          _ = phi50 8 (4 * m % 6561) t' *
              (621756 * 1250 ^ (t' + 100) * 1261 ^ 100) := by ring
          _ ≤ phi50 8 m (t' + 100) *
              (621756 * 1250 ^ (t' + 100) * 1261 ^ 100) :=
              Nat.mul_le_mul_right _ hrec
      · -- m ≡ 8 (mod 9): branch with 1-step retardation
        have hrec := phi50_rec_eight (k := 8) (m := m) (t := t')
          (by norm_num) h9 hne
        rw [e8] at hrec
        have hw : (2 * m - 1) % 6561 / 3 < 2187 := by
          have : (2 * m - 1) % 6561 < 6561 := Nat.mod_lt _ (by norm_num)
          omega
        have hw3 : ((2 * m - 1) % 6561 / 3) % 3 = 2 := by omega
        set w := (2 * m - 1) % 6561 / 3 with hwdef
        have ihw1 := ih (t' + 99) (by omega) w (by omega) hw3
        have ihw2 := ih (t' + 99) (by omega) (w + 2187) (by omega) (by omega)
        have ihw3 := ih (t' + 99) (by omega) (w + 4374) (by omega) (by omega)
        have hmin : cbar w * 1261 ^ (t' + 99) * 1250 ^ 100 ≤
            phiMin50 8 w (t' + 99) *
              (621756 * 1250 ^ (t' + 99) * 1261 ^ 100) := by
          unfold cbar phiMin50
          rw [show (3 : ℕ) ^ (8 - 1) = 2187 by norm_num,
            show (2 * 2187 : ℕ) = 4374 by norm_num]
          have key := K5.min3_mul_bound
            (E := 1261 ^ (t' + 99) * 1250 ^ 100)
            (D := 621756 * 1250 ^ (t' + 99) * 1261 ^ 100)
            (by calc c w * (1261 ^ (t' + 99) * 1250 ^ 100)
                  = c w * 1261 ^ (t' + 99) * 1250 ^ 100 := by ring
                _ ≤ _ := ihw1)
            (by calc c (w + 2187) * (1261 ^ (t' + 99) * 1250 ^ 100)
                  = c (w + 2187) * 1261 ^ (t' + 99) * 1250 ^ 100 := by ring
                _ ≤ _ := ihw2)
            (by calc c (w + 4374) * (1261 ^ (t' + 99) * 1250 ^ 100)
                  = c (w + 4374) * 1261 ^ (t' + 99) * 1250 ^ 100 := by ring
                _ ≤ _ := ihw3)
          calc min (c w) (min (c (w + 2187)) (c (w + 4374))) *
                1261 ^ (t' + 99) * 1250 ^ 100
              = min (c w) (min (c (w + 2187)) (c (w + 4374))) *
                (1261 ^ (t' + 99) * 1250 ^ 100) := by ring
            _ ≤ _ := key
        have hcm := (hcert.2.2) h9
        calc c m * 1261 ^ (t' + 100) * 1250 ^ 100
            = (c m * 1261 ^ 100) * (1261 ^ t' * 1250 ^ 100) := by ring
          _ ≤ (c (4 * m % 6561) * 1250 ^ 100 +
                cbar w * (1261 ^ 99 * 1250)) *
              (1261 ^ t' * 1250 ^ 100) := Nat.mul_le_mul_right _ hcm
          _ = (c (4 * m % 6561) * 1261 ^ t' * 1250 ^ 100) * 1250 ^ 100 +
              (cbar w * 1261 ^ (t' + 99) * 1250 ^ 100) * 1250 ^ 1 := by
              ring
          _ ≤ (phi50 8 (4 * m % 6561) t' *
                (621756 * 1250 ^ t' * 1261 ^ 100)) * 1250 ^ 100 +
              (phiMin50 8 w (t' + 99) *
                (621756 * 1250 ^ (t' + 99) * 1261 ^ 100)) * 1250 ^ 1 :=
              Nat.add_le_add (Nat.mul_le_mul_right _ ih4)
                (Nat.mul_le_mul_right _ hmin)
          _ = (phi50 8 (4 * m % 6561) t' + phiMin50 8 w (t' + 99)) *
              (621756 * 1250 ^ (t' + 100) * 1261 ^ 100) := by ring
          _ ≤ phi50 8 m (t' + 100) *
              (621756 * 1250 ^ (t' + 100) * 1261 ^ 100) :=
              Nat.mul_le_mul_right _ hrec

/-- THE THEOREM: a machine-verified density exponent ABOVE the critical
    line: #{n ≤ 80000·2^y reaching 1} = Ω((1261/1250)^(50y)) =
    Ω(x^0.63201), versus the critical density log 2/log 3 = 0.63093. -/
theorem density_bound (y : ℕ) :
    234400 * 1261 ^ (50 * y) * 1250 ^ 100 ≤
      reachesOneCount (80000 * 2 ^ y + 1) *
        (621756 * 1250 ^ (50 * y) * 1261 ^ 100) := by
  classical
  have h8root : (8 : ℕ) ∈ Roots 8 8 :=
    ⟨by norm_num, by norm_num, ⟨0, rfl⟩⟩
  have hcap : cap (50 * y) * 8 = 80000 * 2 ^ y := by
    unfold cap
    have h1 : 50 * y / 50 = y := by omega
    have h2 : 50 * y % 50 = 0 := by omega
    rw [h1, h2, show rt 0 = 10000 by decide]
    ring
  have hphi : phi50 8 8 (50 * y) ≤ cnt 8 (cap (50 * y) * 8) :=
    phi50_le h8root
  have hsub : treeSet 8 (cap (50 * y) * 8)
      ⊆ @Finset.filter _ (fun n => ∃ t, terras_iter t n = 1)
        (Classical.decPred _) (Finset.range (80000 * 2 ^ y + 1)) := by
    intro n hn
    rw [mem_treeSet] at hn
    rw [Finset.mem_filter, Finset.mem_range]
    obtain ⟨j, hj, _⟩ := hn.2
    constructor
    · rw [hcap] at hn
      omega
    · exact ⟨j + 3, by
        rw [← terras_iter_add, hj, terras_iter_three_eight]⟩
  have hcnt : cnt 8 (cap (50 * y) * 8) ≤
      reachesOneCount (80000 * 2 ^ y + 1) := by
    unfold reachesOneCount cnt
    exact Finset.card_le_card hsub
  have hgrow := growth (50 * y) 8 (by norm_num) (by norm_num)
  have hc8 : c 8 = 234400 := by decide
  rw [hc8] at hgrow
  calc 234400 * 1261 ^ (50 * y) * 1250 ^ 100
      ≤ phi50 8 8 (50 * y) * (621756 * 1250 ^ (50 * y) * 1261 ^ 100) :=
        hgrow
    _ ≤ cnt 8 (cap (50 * y) * 8) *
        (621756 * 1250 ^ (50 * y) * 1261 ^ 100) :=
        Nat.mul_le_mul_right _ hphi
    _ ≤ reachesOneCount (80000 * 2 ^ y + 1) *
        (621756 * 1250 ^ (50 * y) * 1261 ^ 100) :=
        Nat.mul_le_mul_right _ hcnt

end K8
