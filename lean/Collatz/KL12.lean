/-- Entry i of the certificate (class m = 3i + 2). -/
def get (i : ℕ) : ℕ := (shard (i / 2187) >>> (32 * (i % 2187))) &&& 4294967295

/-- The certificate as a function of the class m. -/
def c (m : ℕ) : ℕ := get ((m - 2) / 3)

def pp : ℕ := 101182
def qq : ℕ := 100000
def Cmax : ℕ := 16777216

/-- The per-class condition: bounds and the three inequalities of `CertOK`. -/
def ClassOK (m : ℕ) : Prop :=
  (1 ≤ c m ∧ c m ≤ Cmax) ∧
  (m % 9 = 5 → c m * pp ^ 100 ≤ c (4 * m % 531441) * qq ^ 100) ∧
  (m % 9 = 2 → c m * pp ^ 100 ≤ c (4 * m % 531441) * qq ^ 100 +
    cbarG 12 c ((4 * m - 2) % 531441 / 3) * (pp ^ 79 * qq ^ 21)) ∧
  (m % 9 = 8 → c m * pp ^ 100 * qq ^ 29 ≤ c (4 * m % 531441) * qq ^ 129 +
    cbarG 12 c ((2 * m - 1) % 531441 / 3) * pp ^ 129)

/-- The per-class condition as a Boolean computation (kernel-accelerated
    `Nat.ble`), and its bridge to `ClassOK`. -/
def checkM (m : ℕ) : Bool :=
  (decide (1 ≤ c m) && decide (c m ≤ Cmax)) &&
  (if m % 9 = 5 then decide (c m * pp ^ 100 ≤ c (4 * m % 531441) * qq ^ 100) else true) &&
  (if m % 9 = 2 then decide (c m * pp ^ 100 ≤ c (4 * m % 531441) * qq ^ 100 +
    cbarG 12 c ((4 * m - 2) % 531441 / 3) * (pp ^ 79 * qq ^ 21)) else true) &&
  (if m % 9 = 8 then decide (c m * pp ^ 100 * qq ^ 29 ≤ c (4 * m % 531441) * qq ^ 129 +
    cbarG 12 c ((2 * m - 1) % 531441 / 3) * pp ^ 129) else true)

theorem classOK_of_checkM (m : ℕ) (h : checkM m = true) : ClassOK m := by
  unfold checkM at h
  simp only [Bool.and_eq_true, decide_eq_true_eq] at h
  obtain ⟨⟨⟨h1, h2⟩, h5⟩, h8⟩ := h
  refine ⟨h1, ?_, ?_, ?_⟩
  · intro hm; rw [if_pos hm] at h2; exact of_decide_eq_true h2
  · intro hm; rw [if_pos hm] at h5; exact of_decide_eq_true h5
  · intro hm; rw [if_pos hm] at h8; exact of_decide_eq_true h8

def check (i : ℕ) : Bool := checkM (3 * i + 2)

/-- Divide-and-conquer range check (logarithmic depth for the kernel). -/
def okRange (f : ℕ → Bool) : ℕ → ℕ → ℕ → Bool
  | 0, lo, hi => if hi ≤ lo then true else if hi = lo + 1 then f lo else false
  | fuel + 1, lo, hi =>
      if hi ≤ lo then true else if hi = lo + 1 then f lo
      else okRange f fuel lo ((lo + hi) / 2) && okRange f fuel ((lo + hi) / 2) hi

theorem okRange_sound (f : ℕ → Bool) : ∀ fuel lo hi, okRange f fuel lo hi = true →
    ∀ i, lo ≤ i → i < hi → f i = true := by
  intro fuel
  induction fuel with
  | zero =>
    intro lo hi h i h1 h2
    simp only [okRange] at h
    split_ifs at h with hle heq
    · omega
    · have : i = lo := by omega
      subst this; exact h
  | succ fuel ih =>
    intro lo hi h i h1 h2
    simp only [okRange] at h
    split_ifs at h with hle heq
    · omega
    · have : i = lo := by omega
      subst this; exact h
    · rw [Bool.and_eq_true] at h
      rcases lt_or_ge i ((lo + hi) / 2) with hi' | hi'
      · exact ih lo ((lo + hi) / 2) h.1 i h1 hi'
      · exact ih ((lo + hi) / 2) hi h.2 i hi' h2

