theorem classOK_of_lt (i : ℕ) (hi : i < 177147) : ClassOK (3 * i + 2) :=
  classOK_of_checkM _ (check_all i hi)

theorem classOK_all (m : ℕ) (hm : m < 3 ^ 12) (hm3 : m % 3 = 2) : ClassOK m := by
  have e : m = 3 * ((m - 2) / 3) + 2 := by omega
  have hi : (m - 2) / 3 < 177147 := by
    have : (3 : ℕ) ^ 12 = 531441 := by norm_num
    omega
  rw [e]
  exact classOK_of_lt _ hi

theorem hbounds : ∀ m, m < 3 ^ 12 → m % 3 = 2 → 1 ≤ c m ∧ c m ≤ Cmax :=
  fun m hm hm3 => (classOK_all m hm hm3).1

theorem hcert : CertOK 12 pp qq c := by
  intro m hm hm3
  have h := classOK_all m hm hm3
  have e : (3 : ℕ) ^ 12 = 531441 := by norm_num
  rw [e]
  exact h.2

/-! ## The theorem -/

set_option maxHeartbeats 0 in
theorem c_eight : c 8 = 554204 := by decide +kernel

/-- THE THEOREM: a machine-verified density exponent γ = 50·log₂(101182/100000)
    = 0.8476 > 0.84, the Krasikov–Lagarias 2003 record. -/
theorem density_bound (y : ℕ) :
    554204 * 101182 ^ (50 * y) * 100000 ^ 100 ≤
      reachesOneCount (80000 * 2 ^ y + 1) *
        (16777216 * 100000 ^ (50 * y) * 101182 ^ 100) := by
  classical
  have hgrow := growth_root 12 (by norm_num) pp qq Cmax (by norm_num [pp, qq])
    (by norm_num [qq]) c hbounds hcert (10 * (50 * y) + L 8) (50 * y) 8 rfl
    (by norm_num) (by norm_num) ⟨0, rfl⟩
  have h8 : (8 : ℕ) % 3 ^ 12 = 8 := by norm_num
  rw [h8, c_eight] at hgrow
  have hcap : cap (50 * y) * 8 = 80000 * 2 ^ y := by
    unfold cap
    have h1 : 50 * y / 50 = y := by omega
    have h2 : 50 * y % 50 = 0 := by omega
    rw [h1, h2, show rt 0 = 10000 by decide]
    ring
  have hsub : treeSet 8 (cap (50 * y) * 8)
      ⊆ @Finset.filter _ (fun n => ∃ t, terras_iter t n = 1)
        (Classical.decPred _) (Finset.range (80000 * 2 ^ y + 1)) := by
    intro n hn
    rw [mem_treeSet] at hn
    rw [Finset.mem_filter, Finset.mem_range]
    obtain ⟨j, hj, _⟩ := hn.2
    constructor
    · rw [hcap] at hn
      omega
    · exact ⟨j + 3, by
        rw [← terras_iter_add, hj, terras_iter_three_eight]⟩
  have hcnt : cnt 8 (cap (50 * y) * 8) ≤
      reachesOneCount (80000 * 2 ^ y + 1) := by
    unfold reachesOneCount cnt
    exact Finset.card_le_card hsub
  unfold pp qq Cmax at hgrow
  calc 554204 * 101182 ^ (50 * y) * 100000 ^ 100
      ≤ cnt 8 (cap (50 * y) * 8) * (16777216 * 100000 ^ (50 * y) * 101182 ^ 100) := hgrow
    _ ≤ reachesOneCount (80000 * 2 ^ y + 1) *
        (16777216 * 100000 ^ (50 * y) * 101182 ^ 100) :=
        Nat.mul_le_mul_right _ hcnt

